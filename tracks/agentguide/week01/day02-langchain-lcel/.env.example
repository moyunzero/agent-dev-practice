# 复制为 .env 后按需修改

# --- Ollama（本地，无需 key）---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:0.6b

# --- OpenRouter（免费模型，需要 API Key：https://openrouter.ai/keys）---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# 路由到免费模型池；也可换成具体 :free 模型，如 google/gemma-2-9b-it:free
OPENROUTER_MODEL=openrouter/free
